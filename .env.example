# AratBazar Environment Variables Configuration
# Copy this to .env.local for local development or add to Vercel / GitHub Secrets

# 1. Google Gemini AI API Key (Used by scripts/generate-daily-content.js in GitHub Actions)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Google AdSense Publisher ID (Format: ca-pub-XXXXXXXXXXXXXXXX)
# Found in your Google AdSense Account -> Account Settings -> Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 3. Google Search Console Verification Meta Tag (Optional)
# Enter the verification token provided by Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
