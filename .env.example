# AratBazar Environment Variables Configuration
# 100% FREE • NO PAID API KEYS REQUIRED!

# Google AdSense Publisher ID (Required ONLY when you activate Google Ads)
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Set this in Vercel Dashboard -> Settings -> Environment Variables
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Search Console Verification Meta Tag
# Set this in Vercel Dashboard to verify domain ownership
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=_N0pjK4jsVVQxYeyeZAQp0gebsiRLi9fKjna2i74B1M

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7DXMHPCQQ0

# Formspree Contact Form ID (FREE — https://formspree.io)
# 1. Go to https://formspree.io and create a free account
# 2. Create a new form → copy the Form ID (e.g. xpwzgkla)
# 3. Paste it here. Without this, the contact form will open the user's email client as a fallback.
NEXT_PUBLIC_FORMSPREE_ID=
